# API mode: "mock" (default) simulates latency and stores attendance in the
# browser; "live" talks to the Google Apps Script web app below.
VITE_API_MODE=mock

# LIVE mode only: the Apps Script web app URL (ends in /exec).
VITE_APPS_SCRIPT_URL=

# LIVE mode only, optional: must equal the API_KEY script property set in Apps
# Script. It ships inside the client bundle, so treat it as a speed bump, not a
# secret.
VITE_API_KEY=

# Optional: base URL for picture_ref values that are bare filenames
# (e.g. https://cdn.example.org/student-photos). Full URLs and Google Drive
# links work without this.
VITE_PHOTO_BASE_URL=
