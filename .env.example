# Nothing here is required. The Google Sheet connection is entered in the app itself
# (the gear icon → Settings), stored on-device, and can be changed at any time without a
# new build — that's what makes one app build usable by many organizations.
#
# These two variables exist only as a LOCAL DEVELOPMENT convenience: if set, they pre-fill
# the Settings screen the first time the app runs on a device with nothing saved yet, so
# `npm run dev` doesn't need credentials re-typed every time. Leave this file blank (or
# don't create a .env at all) for any build you intend other organizations to install —
# see README "Configuring for your organization".
VITE_APPS_SCRIPT_URL=
VITE_API_KEY=

# Optional: base URL for picture_ref values that are bare filenames
# (e.g. https://cdn.example.org/student-photos). Full URLs and Google Drive
# links work without this.
VITE_PHOTO_BASE_URL=
